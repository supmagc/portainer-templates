{
  "title": "Home Automation Overview",
  "uid": "home-automation-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["home-automation", "openhab", "loki", "grafana", "influxdb"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    { "id": 100, "type": "row", "title": "openHAB", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 1, "title": "Log Line Rate by File",
      "description": "No native openHAB Prometheus exporter is deployed - this is Loki-sourced instead. promtail ships each of openhab.log/events.log/HABApp.log/HABApp_events.log under its own distinct job label ('openhab'/'events'/'habapp'/'habapp_events', see hosts/openhabian/etc/promtail/config.yml) - this panel sums across all four and uses the 'filename' label to split them back out per file. HABApp_events.log is the high-volume one (rotates 5x16MB every ~7min at INFO - see hosts/openhabian/etc/openhab/habapp/logging.yml). A startup logging.Filter to drop the noisy raw ItemStateUpdatedEvent/ThingStatusInfoEvent lines was tried and reverted - openhab-core#1092 means ItemStateUpdatedEvent can carry a value ItemStateChangedEvent never does for the same transition, so dropping it risks losing real information, not just duplicates (see docs/openhabian-monitoring.md). Its logging.yml formatter was trimmed to cut per-line bytes before shipping it regardless. events.log in particular is openHAB's own item-state-change log, so its rate is a reasonable proxy for 'event count'. Y-axis is log-scaled: habapp_events at full volume outnumbers the other three files by 2-3 orders of magnitude, which flattens them to invisible lines on a linear axis.",
      "type": "timeseries", "gridPos": { "x": 0, "y": 1, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "lineWidth": 1, "scaleDistribution": { "type": "log", "log2base": 10 } } }, "overrides": [] },
      "targets": [{ "expr": "sum by (filename) (count_over_time({job=~\"openhab|events|habapp|habapp_events\"}[$__interval]))", "legendFormat": "{{filename}}", "refId": "A" }] },
    { "id": 2, "title": "Total Log Lines (range)", "description": "Total lines per file over the dashboard's time range - a coarse volume check.",
      "type": "table", "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [{ "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Lines" }] }] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Lines", "desc": true }] },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true } } }],
      "targets": [{ "expr": "sum by (filename) (count_over_time({job=~\"openhab|events|habapp|habapp_events\"}[$__range]))", "queryType": "instant", "format": "table", "refId": "A" }] },
    { "id": 3, "title": "Error Lines (range)", "description": "Same generic /error/i text match caveat as Container Overview's error panels - not a structured level field.",
      "type": "stat", "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "NO ERRORS", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(count_over_time({job=~\"openhab|events|habapp|habapp_events\"} |~ \"(?i)error\" [$__range]))", "queryType": "instant", "refId": "A" }] },

    { "id": 101, "type": "row", "title": "Host (Raspberry Pi)", "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 4, "title": "Load (1m)", "type": "stat", "gridPos": { "x": 0, "y": 19, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "node_load1{job=\"openhabian\"}", "instant": true, "refId": "A" }] },
    { "id": 5, "title": "Memory Used %", "type": "stat", "gridPos": { "x": 4, "y": 19, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"openhabian\"} / node_memory_MemTotal_bytes{job=\"openhabian\"})", "instant": true, "refId": "A" }] },
    { "id": 6, "title": "Swap Used %", "type": "stat", "gridPos": { "x": 8, "y": 19, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * (1 - node_memory_SwapFree_bytes{job=\"openhabian\"} / node_memory_SwapTotal_bytes{job=\"openhabian\"})", "instant": true, "refId": "A" }] },
    { "id": 7, "title": "Disk Used % (root)", "type": "stat", "gridPos": { "x": 12, "y": 19, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"openhabian\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"openhabian\", mountpoint=\"/\"})", "instant": true, "refId": "A" }] },
    { "id": 8, "title": "CPU Temp", "type": "stat", "gridPos": { "x": 16, "y": 19, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "celsius", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 80 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "max(node_hwmon_temp_celsius{job=\"openhabian\", chip=\"thermal_thermal_zone0\"})", "instant": true, "refId": "A" }] },
    { "id": 9, "title": "Uptime", "type": "stat", "gridPos": { "x": 20, "y": 19, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "dtdhms", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "time() - node_boot_time_seconds{job=\"openhabian\"}", "instant": true, "refId": "A" }] },

    { "id": 25, "title": "Load (1m / 5m / 15m)", "type": "timeseries", "gridPos": { "x": 0, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "node_load1{job=\"openhabian\"}", "legendFormat": "1m", "refId": "A" },
        { "expr": "node_load5{job=\"openhabian\"}", "legendFormat": "5m", "refId": "B" },
        { "expr": "node_load15{job=\"openhabian\"}", "legendFormat": "15m", "refId": "C" }
      ] },
    { "id": 26, "title": "CPU Usage %", "type": "timeseries", "gridPos": { "x": 6, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "100 - 100 * avg(rate(node_cpu_seconds_total{job=\"openhabian\", mode=\"idle\"}[$__rate_interval]))", "legendFormat": "cpu", "refId": "A" }
      ] },
    { "id": 27, "title": "Memory / Swap Used %", "type": "timeseries", "gridPos": { "x": 12, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"openhabian\"} / node_memory_MemTotal_bytes{job=\"openhabian\"})", "legendFormat": "memory", "refId": "A" },
        { "expr": "100 * (1 - node_memory_SwapFree_bytes{job=\"openhabian\"} / node_memory_SwapTotal_bytes{job=\"openhabian\"})", "legendFormat": "swap", "refId": "B" }
      ] },
    { "id": 28, "title": "CPU Temp", "type": "timeseries", "gridPos": { "x": 18, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "max(node_hwmon_temp_celsius{job=\"openhabian\", chip=\"thermal_thermal_zone0\"})", "legendFormat": "cpu", "refId": "A" }
      ] },
    { "id": 105, "type": "row", "title": "Storage Health (SD card + SSD)", "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 18, "title": "SSD SMART Status", "description": "Overall pass/fail only. A damaged SSD can still read PASSED; see Bad Sectors (DiskBadSectors alert).", "type": "stat", "gridPos": { "x": 0, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "mappings": [{ "type": "value", "options": { "1": { "text": "PASSED", "color": "green" }, "0": { "text": "FAILED", "color": "red" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "smartctl_device_smart_status{instance=~\"openhabian.*\"}", "instant": true, "refId": "A" }] },
    { "id": 19, "title": "SSD Temperature", "description": "DiskTemperatureHigh alerts above 55 C for 10 minutes.", "type": "stat", "gridPos": { "x": 4, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "celsius", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 45 }, { "color": "red", "value": 55 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "smartctl_device_temperature{instance=~\"openhabian.*\", temperature_type=\"current\"}", "instant": true, "refId": "A" }] },
    { "id": 20, "title": "SSD Bad Sectors", "description": "Raw SMART attributes 5 (reallocated) + 197 (pending) + 198 (offline uncorrectable); anything above 0 triggers DiskBadSectors.", "type": "stat", "gridPos": { "x": 8, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(smartctl_device_attribute{instance=~\"openhabian.*\", attribute_value_type=\"raw\", attribute_id=~\"5|197|198\"})", "instant": true, "refId": "A" }] },
    { "id": 21, "title": "Root FS Read-only", "description": "A read-only remount usually follows SD card failure. The SD card has no SMART data.", "type": "stat", "gridPos": { "x": 12, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "mappings": [{ "type": "value", "options": { "0": { "text": "Read-write", "color": "green" }, "1": { "text": "READ-ONLY", "color": "red" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "node_filesystem_readonly{job=\"openhabian\", mountpoint=\"/\"}", "instant": true, "refId": "A" }] },
    { "id": 22, "title": "Storage I/O Errors (range)", "description": "Kernel/ext4 errors in the Pi journal (PiStorageIoErrors alert). The SSD has a known damaged directory, so Amanda runs re-log it.", "type": "stat", "gridPos": { "x": 16, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(count_over_time({host=\"openhabin\", job=\"journal\"} |~ \"(?i)mmcblk0.*(error|timeout)|EXT4-fs error|Buffer I/O error|blk_update_request|Remounting filesystem read-only\" [$__range]))", "queryType": "instant", "refId": "A" }] },
    { "id": 23, "title": "Written (24h)", "description": "Data written per device over 24h: a wear indicator for the boot SD card (mmcblk0), the mirror SD card in the USB reader (sda, written by sdrsync every 2h) and the SSD (sdb).", "type": "stat", "gridPos": { "x": 20, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "increase(node_disk_written_bytes_total{job=\"openhabian\", device=~\"mmcblk0|sd[a-z]\"}[24h])", "legendFormat": "{{device}}", "instant": true, "refId": "A" }] },

    { "id": 24, "title": "Disk Read / Write", "description": "Throughput per device: boot SD card (mmcblk0), the mirror SD card in the USB reader (sda) and the SSD (sdb). Sustained writes here are what wear flash out - see the DiskWriteSustainedHigh alert (500 KB/s over 6h).",
      "type": "timeseries", "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total{job=\"openhabian\", device=~\"mmcblk0|sd[a-z]\"}[$__rate_interval])", "legendFormat": "{{device}} read", "refId": "A" },
        { "expr": "rate(node_disk_written_bytes_total{job=\"openhabian\", device=~\"mmcblk0|sd[a-z]\"}[$__rate_interval])", "legendFormat": "{{device}} write", "refId": "B" }
      ] },

    { "id": 102, "type": "row", "title": "Scheduled Backups", "description": "openhabian-config schedules backups as systemd timers, not cron (see docs/openhabian-backup.md in openhab/openhabian) - amdump-<config> for the data backup, amandaBackupDB for Amanda's own database, sdrawcopy/sdrsync for SD-card mirroring if enabled (both are real timers too, not manual-only - see systemd-tasks-metrics.sh). systemd-tasks-metrics.sh (run every 5m via its own timer) translates these into the shared scheduled_job_* family (source=openhabian-timer) - see docs/monitoring.md \"Scheduled jobs (unified)\". These same jobs are also covered by the ScheduledJobStale/ScheduledJobFailed alert rules.", "gridPos": { "x": 0, "y": 44, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 10, "title": "Scheduled Jobs", "description": "One row per job - a job only appears once it has run at least once. Expected Interval is read straight off each timer's own NextElapseUSecRealtime, not a hardcoded guess (see systemd-tasks-metrics.sh).",
      "type": "table", "gridPos": { "x": 0, "y": 45, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "name" }, "properties": [{ "id": "displayName", "value": "Job" }] },
          { "matcher": { "id": "byName", "options": "Last Run" }, "properties": [{ "id": "unit", "value": "dateTimeFromNow" }] },
          { "matcher": { "id": "byName", "options": "Exit Code" }, "properties": [{ "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "Success", "color": "green" } } }, { "type": "range", "options": { "from": 1, "to": 255, "result": { "text": "Failed", "color": "red" } } }] }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] },
          { "matcher": { "id": "byName", "options": "Expected Interval" }, "properties": [{ "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "Enabled" }, "properties": [{ "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "Yes", "color": "green" }, "0": { "text": "No", "color": "text" } } }] }] }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "name", "mode": "outer" } },
        { "id": "organize", "options": { "excludeByName": {
            "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true,
            "job": true, "job 1": true, "job 2": true, "job 3": true, "job 4": true,
            "instance": true, "instance 1": true, "instance 2": true, "instance 3": true, "instance 4": true,
            "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true, "__name__ 4": true,
            "source": true, "source 1": true, "source 2": true, "source 3": true, "source 4": true
          }, "renameByName": { "Value #A": "Last Run", "Value #B": "Exit Code", "Value #C": "Expected Interval", "Value #D": "Enabled" } } }
      ],
      "targets": [
        { "expr": "scheduled_job_last_run_timestamp_seconds{source=\"openhabian-timer\"} * 1000", "instant": true, "format": "table", "refId": "A" },
        { "expr": "scheduled_job_last_exit_code{source=\"openhabian-timer\"}", "instant": true, "format": "table", "refId": "B" },
        { "expr": "scheduled_job_expected_interval_seconds{source=\"openhabian-timer\"}", "instant": true, "format": "table", "refId": "C" },
        { "expr": "scheduled_job_enabled{source=\"openhabian-timer\"}", "instant": true, "format": "table", "refId": "D" }
      ] },

    { "id": 103, "type": "row", "title": "Grafana (local)", "description": "openHABian's own local Grafana instance, separate from this stack's Grafana entirely - its own native /metrics endpoint, always exposed unauthenticated by any Grafana. Go-runtime health only (no dashboard/alerting-specific metrics assumed, to avoid guessing at grafana_* metric names this session couldn't verify live against this second instance).", "gridPos": { "x": 0, "y": 53, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 12, "title": "Status", "type": "stat", "gridPos": { "x": 0, "y": 54, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{instance=\"http://openhabian.bellecerise.local:3000/api/health\"}", "instant": true, "refId": "A" }] },
    { "id": 13, "title": "Goroutines", "type": "stat", "gridPos": { "x": 6, "y": 54, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "go_goroutines{job=\"openhabian-grafana\"}", "instant": true, "refId": "A" }] },
    { "id": 14, "title": "Memory (RSS)", "type": "stat", "gridPos": { "x": 12, "y": 54, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
