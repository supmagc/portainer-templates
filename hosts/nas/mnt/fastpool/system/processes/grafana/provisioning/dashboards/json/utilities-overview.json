{
  "title": "Utilities Overview",
  "uid": "utilities-overview",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "tags": ["utilities", "mariadb", "rabbitmq", "traefik", "step-ca"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    { "id": 100, "type": "row", "title": "MariaDB", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 1, "title": "Status", "type": "stat", "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "mysql_up", "instant": true, "refId": "A" }] },
    { "id": 2, "title": "Uptime", "type": "stat", "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "mysql_global_status_uptime", "instant": true, "refId": "A" }] },
    { "id": 3, "title": "Connections", "type": "stat", "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "mysql_global_status_threads_connected", "instant": true, "refId": "A" }] },
    { "id": 4, "title": "Max Connections", "type": "stat", "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "mysql_global_variables_max_connections", "instant": true, "refId": "A" }] },
    { "id": 5, "title": "InnoDB Buffer Pool Used %", "type": "stat", "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 85 }, { "color": "red", "value": 95 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * (1 - mysql_global_status_buffer_pool_pages{state=\"free\"} / (mysql_global_variables_innodb_buffer_pool_size / mysql_global_status_innodb_page_size))", "instant": true, "refId": "A" }] },
    { "id": 6, "title": "InnoDB Buffer Pool Hit Ratio", "description": "Share of InnoDB page reads served from memory rather than disk. Low values mean the buffer pool is too small for the working set.",
      "type": "stat", "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * (1 - (rate(mysql_global_status_innodb_buffer_pool_reads[$__rate_interval]) / rate(mysql_global_status_innodb_buffer_pool_read_requests[$__rate_interval])))", "instant": true, "refId": "A" }] },
    { "id": 7, "title": "Queries / Slow Queries", "type": "timeseries", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "rate(mysql_global_status_questions[$__rate_interval])", "legendFormat": "Queries/s", "refId": "A" },
        { "expr": "rate(mysql_global_status_slow_queries[$__rate_interval])", "legendFormat": "Slow Queries/s", "refId": "B" }
      ] },
    { "id": 60, "title": "Databases by Size", "description": "Per-schema size (data + indexes), row count, and reclaimable space (data_free) from information_schema. Sort by Size to see what is consuming MariaDB.",
      "type": "table", "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Size" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Reclaimable" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Size", "desc": true }] },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "schema", "mode": "outer" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true }, "renameByName": { "schema": "Database", "Value #A": "Size", "Value #B": "Rows", "Value #C": "Reclaimable" } } }
      ],
      "targets": [
        { "expr": "sum by (schema) (mysql_info_schema_table_size{component=~\"data_length|index_length\"})", "instant": true, "format": "table", "refId": "A" },
        { "expr": "sum by (schema) (mysql_info_schema_table_rows)", "instant": true, "format": "table", "refId": "B" },
        { "expr": "sum by (schema) (mysql_info_schema_table_size{component=\"data_free\"})", "instant": true, "format": "table", "refId": "C" }
      ] },

    { "id": 101, "type": "row", "title": "RabbitMQ", "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 8, "title": "Status", "type": "stat", "gridPos": { "x": 0, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "up{job=\"rabbitmq\"}", "instant": true, "refId": "A" }] },
    { "id": 9, "title": "Connections", "type": "stat", "gridPos": { "x": 4, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "rabbitmq_connections", "instant": true, "refId": "A" }] },
    { "id": 10, "title": "Channels", "type": "stat", "gridPos": { "x": 8, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "rabbitmq_channels", "instant": true, "refId": "A" }] },
    { "id": 11, "title": "Queues", "type": "stat", "gridPos": { "x": 12, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "rabbitmq_queues", "instant": true, "refId": "A" }] },
    { "id": 12, "title": "Consumers", "type": "stat", "gridPos": { "x": 16, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "rabbitmq_global_consumers", "instant": true, "refId": "A" }] },
    { "id": 13, "title": "Memory Alarm", "description": "1 = RabbitMQ has hit its memory high watermark and is blocking publishers.", "type": "stat", "gridPos": { "x": 20, "y": 22, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "ALARM", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "rabbitmq_alarms_memory_used_watermark", "instant": true, "refId": "A" }] },
    { "id": 14, "title": "Ready Messages", "type": "stat", "gridPos": { "x": 0, "y": 26, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages_ready)", "instant": true, "refId": "A" }] },
    { "id": 15, "title": "Unacked Messages", "type": "stat", "gridPos": { "x": 6, "y": 26, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages_unacked)", "instant": true, "refId": "A" }] },
    { "id": 16, "title": "Disk Alarm", "description": "1 = RabbitMQ has hit its free-disk-space watermark and is blocking publishers.", "type": "stat", "gridPos": { "x": 12, "y": 26, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "ALARM", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "rabbitmq_alarms_free_disk_space_watermark", "instant": true, "refId": "A" }] },
    { "id": 17, "title": "File Descriptors Used %", "type": "stat", "gridPos": { "x": 18, "y": 26, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * rabbitmq_process_open_fds / rabbitmq_process_max_fds", "instant": true, "refId": "A" }] },
    { "id": 18, "title": "Message Throughput", "type": "timeseries", "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "rate(rabbitmq_global_messages_received_total[$__rate_interval])", "legendFormat": "Published", "refId": "A" },
        { "expr": "rate(rabbitmq_global_messages_delivered_total[$__rate_interval])", "legendFormat": "Delivered", "refId": "B" },
        { "expr": "rate(rabbitmq_global_messages_acknowledged_total[$__rate_interval])", "legendFormat": "Acked", "refId": "C" }
      ] },
    { "id": 19, "title": "Queue Detail", "description": "Ready/unacked message counts and consumer count per queue. Sort by any column to spot a stuck or unconsumed queue.",
      "type": "table", "gridPos": { "x": 0, "y": 38, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Ready" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] },
          { "matcher": { "id": "byName", "options": "Unacked" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Ready", "desc": true }] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "vhost": true }, "renameByName": { "Value #A": "Ready", "Value #B": "Unacked", "Value #C": "Consumers" } } }
      ],
      "targets": [
        { "expr": "rabbitmq_queue_messages_ready", "instant": true, "format": "table", "refId": "A" },
        { "expr": "rabbitmq_queue_messages_unacked", "instant": true, "format": "table", "refId": "B" },
        { "expr": "rabbitmq_queue_consumers", "instant": true, "format": "table", "refId": "C" }
      ] },

    { "id": 102, "type": "row", "title": "Traefik", "description": "Requires the traefik service to be redeployed with Prometheus metrics enabled - panels show No Data until then.", "gridPos": { "x": 0, "y": 47, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 20, "title": "Requests/s", "type": "stat", "gridPos": { "x": 0, "y": 48, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik\"}[$__rate_interval]))", "instant": true, "refId": "A" }] },
    { "id": 21, "title": "5xx Rate", "type": "stat", "gridPos": { "x": 6, "y": 48, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik\", code=~\"5..\"}[$__rate_interval]))", "instant": true, "refId": "A" }] },
    { "id": 22, "title": "p95 Latency", "type": "stat", "gridPos": { "x": 12, "y": 48, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik\"}[$__rate_interval])) by (le))", "instant": true, "refId": "A" }] },
    { "id": 23, "title": "Backends Down", "type": "stat", "gridPos": { "x": 18, "y": 48, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "count(traefik_service_server_up{job=\"traefik\"} == 0) or vector(0)", "instant": true, "refId": "A" }] },
    { "id": 24, "title": "Requests by Entrypoint", "type": "timeseries", "gridPos": { "x": 0, "y": 52, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "sum by (entrypoint) (rate(traefik_entrypoint_requests_total{job=\"traefik\"}[$__rate_interval]))", "legendFormat": "{{entrypoint}}", "refId": "A" }] },
    { "id": 25, "title": "Backend Status", "description": "traefik_service_server_up per backend service - 0 means Traefik currently considers that backend unreachable.",
      "type": "table", "gridPos": { "x": 0, "y": 60, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "color-background" } }, "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Status" }] }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true } } }],
      "targets": [{ "expr": "traefik_service_server_up{job=\"traefik\"}", "instant": true, "format": "table", "refId": "A" }] },
    { "id": 26, "title": "Certificate Expiry", "description": "Every certificate this Traefik instance currently holds via traefik_tls_certs_not_after, sorted soonest-expiring first. Covers everything issued through the stepca resolver, not just step-ca's own listener cert.",
      "type": "table", "gridPos": { "x": 0, "y": 68, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Days Until Expiry" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 7 }, { "color": "green", "value": 30 } ] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "unit", "value": "short" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Days Until Expiry", "desc": false }] },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true }, "renameByName": { "Value": "Days Until Expiry" } } }],
      "targets": [{ "expr": "(traefik_tls_certs_not_after{job=\"traefik\"} - time()) / 86400", "instant": true, "format": "table", "refId": "A" }] },

    { "id": 104, "type": "row", "title": "Traefik Edge", "description": "The internet-facing reverse proxy (Dynu DNS-challenge resolver, separate from the internal stepca-issued certs above).", "gridPos": { "x": 0, "y": 77, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 30, "title": "Requests/s", "type": "stat", "gridPos": { "x": 0, "y": 78, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik-edge\"}[$__rate_interval]))", "instant": true, "refId": "A" }] },
    { "id": 31, "title": "5xx Rate", "type": "stat", "gridPos": { "x": 6, "y": 78, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik-edge\", code=~\"5..\"}[$__rate_interval]))", "instant": true, "refId": "A" }] },
    { "id": 32, "title": "p95 Latency", "type": "stat", "gridPos": { "x": 12, "y": 78, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik-edge\"}[$__rate_interval])) by (le))", "instant": true, "refId": "A" }] },
    { "id": 33, "title": "Backends Down", "type": "stat", "gridPos": { "x": 18, "y": 78, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "count(traefik_service_server_up{job=\"traefik-edge\"} == 0) or vector(0)", "instant": true, "refId": "A" }] },
    { "id": 34, "title": "Requests by Entrypoint", "type": "timeseries", "gridPos": { "x": 0, "y": 82, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "sum by (entrypoint) (rate(traefik_entrypoint_requests_total{job=\"traefik-edge\"}[$__rate_interval]))", "legendFormat": "{{entrypoint}}", "refId": "A" }] },
    { "id": 35, "title": "Backend Status", "description": "traefik_service_server_up per backend service - 0 means traefik-edge currently considers that backend unreachable.",
      "type": "table", "gridPos": { "x": 0, "y": 90, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "color-background" } }, "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Status" }] }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true } } }],
      "targets": [{ "expr": "traefik_service_server_up{job=\"traefik-edge\"}", "instant": true, "format": "table", "refId": "A" }] },
    { "id": 36, "title": "Certificate Expiry", "description": "Certificates held by traefik-edge via traefik_tls_certs_not_after - the publicly-trusted certs from the dynu DNS-challenge resolver, sorted soonest-expiring first.",
      "type": "table", "gridPos": { "x": 0, "y": 98, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Days Until Expiry" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 7 }, { "color": "green", "value": 30 } ] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "unit", "value": "short" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Days Until Expiry", "desc": false }] },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true }, "renameByName": { "Value": "Days Until Expiry" } } }],
      "targets": [{ "expr": "(traefik_tls_certs_not_after{job=\"traefik-edge\"} - time()) / 86400", "instant": true, "format": "table", "refId": "A" }] },

    { "id": 103, "type": "row", "title": "step-ca", "gridPos": { "x": 0, "y": 107, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 27, "title": "Reachable", "type": "stat", "gridPos": { "x": 0, "y": 108, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{instance=\"https://step-ca:9000/health\"}", "instant": true, "refId": "A" }] },
    { "id": 28, "title": "Own Cert Expiry (days)", "description": "TLS certificate presented directly by step-ca's own health endpoint (separate from anything issued to Traefik-fronted services above).",
      "type": "stat", "gridPos": { "x": 8, "y": 108, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 7 }, { "color": "green", "value": 30 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "(probe_ssl_earliest_cert_expiry{instance=\"https://step-ca:9000/health\"} - time()) / 86400", "instant": true, "refId": "A" }] },
    { "id": 29, "title": "Probe Latency", "type": "stat", "gridPos": { "x": 16, "y": 108, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_duration_seconds{instance=\"https://step-ca:9000/health\"}", "instant": true, "refId": "A" }] },

    { "id": 110, "type": "row", "title": "PostgreSQL", "description": "Shared cluster (utilities stack) backing bitmagnet, and immich later. Per-database size needs postgres-exporter's `database` collector (set in compose).", "gridPos": { "x": 0, "y": 112, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 61, "title": "Status", "type": "stat", "gridPos": { "x": 0, "y": 113, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "pg_up", "instant": true, "refId": "A" }] },
    { "id": 62, "title": "Uptime", "type": "stat", "gridPos": { "x": 4, "y": 113, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "time() - pg_postmaster_start_time_seconds", "instant": true, "refId": "A" }] },
    { "id": 63, "title": "Connections", "type": "stat", "gridPos": { "x": 8, "y": 113, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends)", "instant": true, "refId": "A" }] },
    { "id": 64, "title": "Max Connections", "type": "stat", "gridPos": { "x": 12, "y": 113, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "pg_settings_max_connections", "instant": true, "refId": "A" }] },
    { "id": 65, "title": "Cache Hit Ratio", "type": "stat", "gridPos": { "x": 16, "y": 113, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":90},{"color":"green","value":99}] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "100 * sum(pg_stat_database_blks_hit) / clamp_min(sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read), 1)", "instant": true, "refId": "A" }] },
    { "id": 66, "title": "Deadlocks (1h)", "type": "stat", "gridPos": { "x": 20, "y": 113, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":1}] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(increase(pg_stat_database_deadlocks[1h]))", "instant": true, "refId": "A" }] },
    { "id": 67, "title": "Transactions/s", "type": "timeseries", "gridPos": { "x": 0, "y": 117, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit[$__rate_interval]))", "legendFormat": "Commits", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback[$__rate_interval]))", "legendFormat": "Rollbacks", "refId": "B" }
      ] },
    { "id": 68, "title": "Databases", "description": "Size, live connections, and commit rate per database (templates excluded).",
      "type": "table", "gridPos": { "x": 0, "y": 125, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } },
        "overrides": [{ "matcher": { "id": "byName", "options": "Size" }, "properties": [{ "id": "unit", "value": "bytes" }] }] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Size", "desc": true }] },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "datname", "mode": "outer" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "server": true }, "renameByName": { "datname": "Database", "Value #A": "Size", "Value #B": "Connections", "Value #C": "Commits/s" } } }
      ],
      "targets": [
        { "expr": "pg_database_size_bytes{datname!~\"template.*\"}", "instant": true, "format": "table", "refId": "A" },
        { "expr": "pg_stat_database_numbackends{datname!~\"template.*\"}", "instant": true, "format": "table", "refId": "B" },
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[$__rate_interval]))", "instant": true, "format": "table", "refId": "C" }
      ] }
  ]
}
