{
  "title": "OpenHabian Details",
  "uid": "openhabian-details",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["infra", "openhab", "loki"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Log Line Rate by File",
      "description": "No native openHAB Prometheus exporter is deployed - this is Loki-sourced instead, using promtail's automatic 'filename' label to split events.log/openhab.log/HABApp.log/HABApp_events.log (all tailed under one 'openhab' job, see scratchpad/host-configs/openhabian-pi/promtail-config.yml). events.log in particular is openHAB's own item-state-change log, so its rate is a reasonable proxy for 'event count'.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (filename) (count_over_time({job=\"openhab\"}[$__interval]))",
          "legendFormat": "{{filename}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Log Lines (range)",
      "description": "Total lines per file over the dashboard's time range - a coarse volume check.",
      "type": "table",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Lines" }] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Lines", "desc": true }]
      },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ],
      "targets": [
        {
          "expr": "sum by (filename) (count_over_time({job=\"openhab\"}[$__range]))",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Lines (range)",
      "description": "Same generic /error/i text match caveat as Container Overview's error panels - not a structured level field.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"openhab\"} |~ \"(?i)error\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    }
  ]
}
