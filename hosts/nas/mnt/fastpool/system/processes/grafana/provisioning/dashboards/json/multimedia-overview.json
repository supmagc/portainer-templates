      "targets": [{ "expr": "prowlarr_system_health_issues", "instant": true, "refId": "A" }] },
    { "id": 28, "title": "Indexer Health", "description": "Per-indexer query/grab failure counts and average response time. Sort by any column - failures are highlighted so a struggling or dead indexer stands out.",
      "type": "table", "gridPos": { "x": 0, "y": 33, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Failed Queries" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] },
          { "matcher": { "id": "byName", "options": "Failed Grabs" }, "properties": [{ "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] },
          { "matcher": { "id": "byName", "options": "Avg Response (ms)" }, "properties": [{ "id": "unit", "value": "ms" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Failed Queries", "desc": true }] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "app": true, "url": true }, "renameByName": { "Value #A": "Queries", "Value #B": "Failed Queries", "Value #C": "Grabs", "Value #D": "Failed Grabs", "Value #E": "Avg Response (ms)" } } }
      ],
      "targets": [
        { "expr": "prowlarr_indexer_queries_total", "instant": true, "format": "table", "refId": "A" },
        { "expr": "prowlarr_indexer_failed_queries_total", "instant": true, "format": "table", "refId": "B" },
        { "expr": "prowlarr_indexer_grabs_total", "instant": true, "format": "table", "refId": "C" },
        { "expr": "prowlarr_indexer_failed_grabs_total", "instant": true, "format": "table", "refId": "D" },
        { "expr": "prowlarr_indexer_average_response_time_ms", "instant": true, "format": "table", "refId": "E" }
      ] },

