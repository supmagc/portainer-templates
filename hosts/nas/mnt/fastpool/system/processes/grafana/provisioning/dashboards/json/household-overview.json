{
  "title": "Household Overview",
  "uid": "household-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["household", "mealie", "vikunja"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    { "id": 100, "type": "row", "title": "Mealie", "description": "No native Prometheus metrics - container (cAdvisor), blackbox probes and its Postgres database only.", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 1, "title": "Health", "type": "stat", "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "-1": { "text": "no check", "color": "text" }, "0": { "text": "Unhealthy", "color": "red" }, "1": { "text": "Healthy", "color": "green" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "max(container_health_state{name=\"mealie\"})", "instant": true, "refId": "A" }] },
    { "id": 2, "title": "Restarts (24h)", "description": "Blind to container recreates (new container id each time) - only counts in-place restarts, e.g. a crash loop.",
      "type": "stat", "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(changes(container_start_time_seconds{name=\"mealie\"}[24h]))", "instant": true, "refId": "A" }] },
    { "id": 3, "title": "Internal HTTPS", "type": "stat", "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik\", router=\"mealie-secure\"}", "instant": true, "refId": "A" }] },
    { "id": 4, "title": "Public HTTPS", "type": "stat", "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik-edge\", router=\"mealie-public\"}", "instant": true, "refId": "A" }] },
    { "id": 5, "title": "Memory", "type": "stat", "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "max(container_memory_working_set_bytes{name=\"mealie\"})", "instant": true, "refId": "A" }] },
    { "id": 6, "title": "Database Size", "type": "stat", "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"mealie\"}", "instant": true, "refId": "A" }] },
    { "id": 7, "title": "CPU", "type": "timeseries", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"mealie\"}[$__rate_interval]))", "legendFormat": "mealie", "refId": "A" }] },
    { "id": 8, "title": "Memory", "type": "timeseries", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "max(container_memory_working_set_bytes{name=\"mealie\"})", "legendFormat": "mealie", "refId": "A" }] },

    { "id": 101, "type": "row", "title": "Vikunja", "description": "Native /api/v1/metrics (VIKUNJA_METRICS_ENABLED), scraped as job=vikunja. Blocked on the public route in traefik-edge/dynamic/vikunja.yml.", "gridPos": { "x": 0, "y": 11, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 11, "title": "Health", "type": "stat", "gridPos": { "x": 0, "y": 12, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "-1": { "text": "no check", "color": "text" }, "0": { "text": "Unhealthy", "color": "red" }, "1": { "text": "Healthy", "color": "green" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "max(container_health_state{name=\"vikunja\"})", "instant": true, "refId": "A" }] },
    { "id": 12, "title": "Restarts (24h)", "description": "Blind to container recreates (new container id each time) - only counts in-place restarts, e.g. a crash loop.",
      "type": "stat", "gridPos": { "x": 4, "y": 12, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
