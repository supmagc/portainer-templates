      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(changes(container_start_time_seconds{name=\"vikunja\"}[24h]))", "instant": true, "refId": "A" }] },
    { "id": 13, "title": "Internal HTTPS", "type": "stat", "gridPos": { "x": 8, "y": 12, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik\", router=\"vikunja-secure\"}", "instant": true, "refId": "A" }] },
    { "id": 14, "title": "Public HTTPS", "type": "stat", "gridPos": { "x": 12, "y": 12, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik-edge\", router=\"vikunja-public\"}", "instant": true, "refId": "A" }] },
    { "id": 15, "title": "Memory", "type": "stat", "gridPos": { "x": 16, "y": 12, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "max(container_memory_working_set_bytes{name=\"vikunja\"})", "instant": true, "refId": "A" }] },
    { "id": 16, "title": "Database Size", "type": "stat", "gridPos": { "x": 20, "y": 12, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"vikunja\"}", "instant": true, "refId": "A" }] },
    { "id": 41, "title": "Tasks", "type": "stat", "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "expr": "vikunja_task_count", "instant": false, "refId": "A" }] },
    { "id": 42, "title": "Projects", "type": "stat", "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "vikunja_project_count", "instant": true, "refId": "A" }] },
    { "id": 43, "title": "Users", "type": "stat", "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "vikunja_user_count", "instant": true, "refId": "A" }] },
    { "id": 44, "title": "Active Users", "description": "Users active within the last 30 seconds.", "type": "stat", "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "vikunja_active_users", "instant": true, "refId": "A" }] },
    { "id": 17, "title": "CPU", "type": "timeseries", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"vikunja\"}[$__rate_interval]))", "legendFormat": "vikunja", "refId": "A" }] },
    { "id": 18, "title": "Memory", "type": "timeseries", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "max(container_memory_working_set_bytes{name=\"vikunja\"})", "legendFormat": "vikunja", "refId": "A" }] },

    { "id": 103, "type": "row", "title": "Nextcloud", "description": "Temporary home for Nextcloud here. nextcloud-exporter usage metrics (users, files, shares...) only appear once its scrape succeeds - see Exporter API.", "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 31, "title": "Internal HTTPS", "type": "stat", "gridPos": { "x": 0, "y": 27, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik\", router=\"nextcloud-web-secure\"}", "instant": true, "refId": "A" }] },
    { "id": 32, "title": "Public HTTPS", "type": "stat", "gridPos": { "x": 4, "y": 27, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik-edge\", router=\"nextcloud-public\"}", "instant": true, "refId": "A" }] },
    { "id": 33, "title": "OnlyOffice HTTPS", "type": "stat", "gridPos": { "x": 8, "y": 27, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "Up", "color": "green" }, "0": { "text": "Down", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\", source=\"traefik\", router=\"onlyoffice-secure\"}", "instant": true, "refId": "A" }] },
    { "id": 34, "title": "Exporter API", "description": "nextcloud_up from nextcloud-exporter: 0 means the exporter cannot query Nextcloud's serverinfo API (bad/missing NEXTCLOUD_EXPORTER_TOKEN or trusted-domain issue), not that Nextcloud is down.",
      "type": "stat", "gridPos": { "x": 12, "y": 27, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "OK", "color": "green" }, "0": { "text": "Failing", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "nextcloud_up", "instant": true, "refId": "A" }] },
    { "id": 35, "title": "Restarts (24h)", "description": "Blind to container recreates (new container id each time) - only counts in-place restarts.",
      "type": "stat", "gridPos": { "x": 16, "y": 27, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(changes(container_start_time_seconds{name=~\"nextcloud|nextcloud-web|nextcloud-cron|nextcloud-rebuilder|onlyoffice\"}[24h]))", "instant": true, "refId": "A" }] },
    { "id": 36, "title": "Database Size", "description": "MariaDB nextcloud schema (data + index) via mysqld-exporter.", "type": "stat", "gridPos": { "x": 20, "y": 27, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum(mysql_info_schema_table_size{schema=\"nextcloud\", component=~\"data_length|index_length\"})", "instant": true, "refId": "A" }] },
    { "id": 37, "title": "Container Health", "type": "table", "gridPos": { "x": 0, "y": 31, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "name" }, "properties": [{ "id": "displayName", "value": "Container" }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Health" }, { "id": "mappings", "value": [{ "type": "value", "options": { "-1": { "text": "no check", "color": "text" }, "0": { "text": "Unhealthy", "color": "red" }, "1": { "text": "Healthy", "color": "green" } } }] }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Container", "desc": false }] },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true } } }],
      "targets": [{ "expr": "max by (name) (container_health_state{name=~\"nextcloud|nextcloud-web|nextcloud-cron|nextcloud-rebuilder|nextcloud-exporter|onlyoffice\"})", "instant": true, "format": "table", "refId": "A" }] },
    { "id": 38, "title": "Memory by Container", "type": "timeseries", "gridPos": { "x": 12, "y": 31, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [{ "expr": "max by (name) (container_memory_working_set_bytes{name=~\"nextcloud|nextcloud-web|nextcloud-cron|nextcloud-rebuilder|nextcloud-exporter|onlyoffice\"})", "legendFormat": "{{name}}", "refId": "A" }] },

    { "id": 102, "type": "row", "title": "Backups", "description": "Dagu mariadb-backup (nextcloud DB) and postgres-backup (mealie + vikunja). Dagu's by-dag counters reset daily at midnight, so these show today's runs only.", "gridPos": { "x": 0, "y": 38, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 21, "title": "Succeeded Today", "type": "stat", "gridPos": { "x": 0, "y": 39, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum by (dag) (dagu_dag_runs_total_by_dag{dag=~\"mariadb-backup|postgres-backup\", status=\"succeeded\"})", "legendFormat": "{{dag}}", "instant": true, "refId": "A" }] },
    { "id": 22, "title": "Failed Today", "type": "stat", "gridPos": { "x": 12, "y": 39, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "targets": [{ "expr": "sum by (dag) (dagu_dag_runs_total_by_dag{dag=~\"mariadb-backup|postgres-backup\", status=\"failed\"}) or 0 * sum by (dag) (dagu_dag_runs_total_by_dag{dag=~\"mariadb-backup|postgres-backup\"})", "legendFormat": "{{dag}}", "instant": true, "refId": "A" }] }
  ]
}
