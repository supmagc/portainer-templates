[Unit]
Description=Loki
After=network-online.target zram-config.service
PartOf=zram-config.service
RequiresMountsFor=/mnt/ssd
Wants=network-online.target

[Service]
User=loki
Group=loki
ExecStart=/usr/local/bin/loki -config.file=/etc/loki/config.yml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/mnt/ssd/loki

[Install]
WantedBy=multi-user.target