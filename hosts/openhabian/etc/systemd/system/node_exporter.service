[Unit]
Description=Prometheus Node Exporter
After=network.target

[Service]
# Scheduled-job state (backup timers, SD-card mirroring) comes from
# systemd-tasks-metrics.sh via the textfile collector now, not
# --collector.systemd read directly - see docs/monitoring.md "Scheduled
# jobs (unified)". /var/lib/node_exporter/textfile must exist and be
# readable by this unit's User (created by systemd-tasks-metrics.sh on
# first run, or `mkdir -p` it by hand before that first run).
ExecStart=/usr/local/bin/node_exporter --collector.textfile.directory=/var/lib/node_exporter/textfile
Restart=on-failure
User=nobody

[Install]
WantedBy=multi-user.target
