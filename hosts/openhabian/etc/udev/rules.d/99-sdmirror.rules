# Stable name for the SanDisk SDDR-B531 USB card reader used as the SD-mirroring
# target. openHABian still needs backupdrive=/dev/sda in /etc/openhabian.conf
# (mirror_SD builds partition paths by string concat and cannot use a by-id
# path), but /dev/sdmirror gives a probe-order-independent handle for manual
# checks and monitoring, and sdmirror-guard.sh cross-checks the reader serial
# regardless.
SUBSYSTEM=="block", KERNEL=="sd*", ENV{ID_SERIAL_SHORT}=="1128240000005943", SYMLINK+="sdmirror%n"

# Belt-and-braces: tag the Transcend SSD so it is obvious in `udevadm info` and
# never gets a name that collides with the mirror target.
SUBSYSTEM=="block", KERNEL=="sd*", ENV{ID_SERIAL_SHORT}=="I964670181", SYMLINK+="ssd%n", ENV{OPENHABIAN_ROLE}="ssd-do-not-mirror"
